<Window x:Class="SnipStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SnipStudio.Controls" xmlns:edit="clr-namespace:SnipStudio.Editor" Style="{StaticResource {x:Type Window}}" Title="Snip Studio" Width="1320" Height="850" MinWidth="1040" MinHeight="650" WindowStartupLocation="CenterScreen" Icon="Assets/SnipStudio.ico" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource AccentFill}" CornerRadius="10" Width="36" Height="36"><ui:Icon Kind="capture" Width="27" Height="27" Stroke="White"/></Border>
          <StackPanel Margin="13,0,0,0"><TextBlock Text="Snip Studio" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Capture. Annotate. Share." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource QuietButton}" Click="Help_Click" ToolTip="Keyboard shortcuts  F1" AutomationProperties.Name="Keyboard shortcuts"><ui:Icon Kind="help" Width="20" Height="20"/></Button>
          <Button Style="{StaticResource QuietButton}" Click="Settings_Click" ToolTip="Settings" Margin="6,0,0,0"><StackPanel Orientation="Horizontal"><ui:Icon Kind="settings" Width="19" Height="19"/><TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="NewButton" Style="{StaticResource PrimaryButton}" Click="New_Click" Width="143" ToolTip="New capture  Ctrl+N"><StackPanel Orientation="Horizontal"><ui:Icon Kind="plus" Width="19" Height="19" Stroke="White"/><TextBlock Text="New snip" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        <ComboBox x:Name="ModeBox" Width="140" Margin="10,0,0,0" SelectionChanged="CaptureOption_Changed" ToolTip="Capture mode" AutomationProperties.Name="Capture mode"><ComboBoxItem Content="Region"/><ComboBoxItem Content="Window"/><ComboBoxItem Content="Screen"/><ComboBoxItem Content="All displays"/></ComboBox>
        <ComboBox x:Name="DelayBox" Width="110" Margin="8,0,0,0" SelectionChanged="CaptureOption_Changed" ToolTip="Delay applies to New snip. Global shortcut is always instant." AutomationProperties.Name="Capture delay"><ComboBoxItem Content="No delay" Tag="0"/><ComboBoxItem Content="3 seconds" Tag="3"/><ComboBoxItem Content="5 seconds" Tag="5"/><ComboBoxItem Content="10 seconds" Tag="10"/></ComboBox>
        <Border Width="1" Background="{StaticResource Line}" Margin="18,5"/>
        <Button Style="{StaticResource QuietButton}" Click="Open_Click" ToolTip="Open an image  Ctrl+O"><StackPanel Orientation="Horizontal"><ui:Icon Kind="open" Width="19" Height="19"/><TextBlock Text="Open" Margin="8,0,0,0"/></StackPanel></Button>
        <Button Style="{StaticResource QuietButton}" Click="Paste_Click" ToolTip="Paste an image  Ctrl+V" Margin="2,0,0,0" Content="Paste"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="PinButton" Style="{StaticResource QuietButton}" Click="Pin_Click" ToolTip="Pin a copy above other windows  Ctrl+P" IsEnabled="False" AutomationProperties.Name="Pin image"><ui:Icon Kind="pin" Width="20" Height="20"/></Button>
        <Button x:Name="CopyButton" Click="Copy_Click" Margin="10,0,0,0" IsEnabled="False" ToolTip="Copy edited image  Ctrl+C"><StackPanel Orientation="Horizontal"><ui:Icon Kind="copy" Width="17" Height="17"/><TextBlock Text="Copy image" Margin="8,0,0,0"/></StackPanel></Button>
        <Button x:Name="SaveButton" Click="Save_Click" Margin="8,0,0,0" IsEnabled="False" ToolTip="Save image  Ctrl+S"><StackPanel Orientation="Horizontal"><ui:Icon Kind="save" Width="17" Height="17"/><TextBlock Text="Save" Margin="8,0,0,0"/></StackPanel></Button>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="18,4,18,12"><Grid.ColumnDefinitions><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="62"/><Style.Triggers><DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ToolScroll}" Value="Visible"><Setter Property="Width" Value="76"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Margin="0,0,10,0">
        <ScrollViewer x:Name="ToolScroll" Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ToolRail" Margin="5,8"/></ScrollViewer>
      </Border>
      <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Background="{StaticResource Panel}" ClipToBounds="True">
        <Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{StaticResource AccentSurface}" CornerRadius="5" Padding="6"><ui:Icon Kind="capture" Width="15" Height="15" Stroke="{StaticResource Accent}"/></Border><TextBlock x:Name="DocumentTitle" Text="Your workspace" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UndoButton" Style="{StaticResource QuietButton}" Padding="8" Click="Undo_Click" IsEnabled="False" ToolTip="Undo  Ctrl+Z" AutomationProperties.Name="Undo"><ui:Icon Kind="undo" Width="18" Height="18"/></Button><Button x:Name="RedoButton" Style="{StaticResource QuietButton}" Padding="8" Click="Redo_Click" IsEnabled="False" ToolTip="Redo  Ctrl+Shift+Z / Ctrl+Y" AutomationProperties.Name="Redo"><ui:Icon Kind="redo" Width="18" Height="18"/></Button><Border Width="1" Background="{StaticResource Line}" Margin="8,6"/><Button x:Name="DeleteButton" Style="{StaticResource QuietButton}" Padding="8" Click="Delete_Click" IsEnabled="False" ToolTip="Delete selected annotation  Delete" AutomationProperties.Name="Delete annotation"><ui:Icon Kind="trash" Width="18" Height="18"/></Button></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid x:Name="StyleControls" Margin="14,0" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel x:Name="Palette" Orientation="Horizontal" VerticalAlignment="Center"/>
              <TextBox x:Name="HexColorBox" Grid.Column="1" Width="77" Margin="7,7,13,7" Padding="6,3" FontSize="11" Text="#E52535" LostKeyboardFocus="HexColor_Changed" ToolTip="Custom color in #RRGGBB format" AutomationProperties.Name="Custom color"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Size" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Slider x:Name="WidthSlider" Width="76" Margin="9,0,5,0" Minimum="1" Maximum="16" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Width_Changed" ToolTip="Stroke width" AutomationProperties.Name="Stroke width"/><TextBlock x:Name="WidthLabel" Text="5" Width="20" FontSize="11" VerticalAlignment="Center"/></StackPanel>
              <ComboBox x:Name="TextSizeBox" Grid.Column="3" Width="75" MinHeight="28" Margin="7,8,0,8" SelectionChanged="TextSize_Changed" ToolTip="Text and numbered step size" AutomationProperties.Name="Text size"><ComboBoxItem Content="18 px" Tag="18"/><ComboBoxItem Content="26 px" Tag="26"/><ComboBoxItem Content="36 px" Tag="36"/><ComboBoxItem Content="48 px" Tag="48"/><ComboBoxItem Content="64 px" Tag="64"/></ComboBox>
            </Grid>
          </Border>
          <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.Background><SolidColorBrush Color="#0E1219"/></Grid.Background>
            <ScrollViewer Style="{StaticResource DarkScrollViewer}" x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="Canvas_SizeChanged" PreviewMouseWheel="Canvas_MouseWheel" Background="Transparent" Visibility="Collapsed">
              <Grid Margin="28" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Background="{StaticResource Panel}"><Border.Effect><DropShadowEffect BlurRadius="20" Opacity="0.12" ShadowDepth="3"/></Border.Effect><edit:EditorSurface x:Name="Editor"><edit:EditorSurface.LayoutTransform><ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/></edit:EditorSurface.LayoutTransform></edit:EditorSurface></Border></Grid>
            </ScrollViewer>
            <Grid x:Name="EmptyState" Background="{StaticResource Canvas}">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="14">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
                <Grid Width="180" Height="112" Margin="0,0,0,23">
                  <Border Width="145" Height="94" Background="#202B39" CornerRadius="12" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-9"/></Border.RenderTransform></Border>
                  <Border Width="145" Height="94" Background="{StaticResource Panel}" BorderBrush="#3D4A60" BorderThickness="1" CornerRadius="12" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="5"/></Border.RenderTransform><Grid><Path Data="M17,67 L49,34 74,55 97,24 129,67Z" Fill="#315449" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="13" Height="13" Fill="#54D6B6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,20,0,0"/></Grid></Border>
                  <Border Background="{StaticResource AccentFill}" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,3"><ui:Icon Kind="capture" Width="27" Height="27" Stroke="White"/></Border>
                </Grid>
                <TextBlock Text="Ready to capture." FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Grab an area, a window, or a whole display." Foreground="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" Margin="0,11,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Take a snip" Click="New_Click" HorizontalAlignment="Center" Margin="0,24,0,0" Padding="24,12"/>
                <TextBlock x:Name="EmptyShortcut" Text="Ctrl + Alt + Shift + S  ·  instant capture" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                <TextBlock Text="or drop an image here · paste with Ctrl + V" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,30,0,0"/>
              </StackPanel>
              </Viewbox>
            </Grid>
          </Grid>
          <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="CanvasInfo" Text="Ready when you are" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}"/>
              <StackPanel x:Name="ZoomControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="False"><Button Style="{StaticResource QuietButton}" Content="−" Padding="9,4" Click="ZoomOut_Click" ToolTip="Zoom out  Ctrl+−"/><Button x:Name="ZoomLabel" Style="{StaticResource QuietButton}" Content="100%" Padding="5,4" Width="52" Click="ActualSize_Click" ToolTip="Actual pixels  Ctrl+1" FontSize="11"/><Button Style="{StaticResource QuietButton}" Content="+" Padding="9,4" Click="ZoomIn_Click" ToolTip="Zoom in  Ctrl++"/><Button Style="{StaticResource QuietButton}" Padding="9,4" Margin="5,0,0,0" Click="Fit_Click" ToolTip="Fit image  Ctrl+0"><StackPanel Orientation="Horizontal"><ui:Icon Kind="fit" Width="14" Height="14"/><TextBlock Text="Fit" Margin="6,0,0,0" FontSize="11"/></StackPanel></Button></StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Column="2" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,7,0,15"><Grid><TextBlock Text="Recent captures" FontSize="15" FontWeight="SemiBold"/><Button x:Name="ClearHistoryButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Padding="7,3" Foreground="{StaticResource Muted}" Content="Clear" Click="ClearHistory_Click" FontSize="11" ToolTip="Clear saved capture history"/></Grid><TextBlock x:Name="HistoryDescription" Text="Saved on this device" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
        <Grid Grid.Row="1">
          <ScrollViewer Style="{StaticResource DarkScrollViewer}" x:Name="HistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0" AutomationProperties.Name="Recent captures"><ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource HistoryCard}" Click="History_Click" Tag="{Binding}" Margin="0,0,0,10" ToolTip="Open this capture"><StackPanel><Border Background="{StaticResource Canvas}" Height="112" CornerRadius="6,6,0,0" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="7"/></Border><StackPanel Margin="11,10"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding Dimensions}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <StackPanel x:Name="HistoryEmpty" VerticalAlignment="Top" Margin="0,30,0,0"><Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource Control}" HorizontalAlignment="Left"><ui:Icon Kind="history" Width="21" Height="21" Stroke="{StaticResource Muted}"/></Border><TextBlock Text="No captures yet" FontWeight="SemiBold" FontSize="12" Margin="0,15,0,0"/><TextBlock Text="Your recent snips will appear here." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="20" Margin="0,7,6,0"/></StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="15" Margin="0,12,0,0"><StackPanel><TextBlock Text="TOOL GUIDE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="ToolTipTitle" Text="Pen" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="ToolHint" Text="Your global shortcut skips the countdown. Capture the moment while it's still there." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="19" Margin="0,7,0,0"/></StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="StatusDot" Fill="{StaticResource Accent}" Width="6" Height="6" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><TextBlock x:Name="ShortcutStatus" Grid.Column="1" Text="Ctrl + Alt + Shift + S" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
</Window>
